rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Kurdish Sorani Facts collection: Publicly readable & admin editable
    match /facts/{factId} {
      allow read: if true;
      allow write: if true;
    }

    // Independent English Facts collection: Publicly readable & admin editable
    match /facts_en/{factId} {
      allow read: if true;
      allow write: if true;
    }

    // Kurdish Collections
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if true;
    }

    // Independent English Collections
    match /collections_en/{collectionId} {
      allow read: if true;
      allow write: if true;
    }

    // Photo Submissions: Publicly creatable and readable for community photo suggestions & admin moderation
    match /photo_submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
